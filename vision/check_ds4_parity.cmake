# Builds ds4's own ds4_image.c (read-only, from DS4_DIR) as a shared library
# and runs TEST_BINARY --ds4 on IMAGES (PATH[=TOKENS:GW:GH] joined by |).
if(NOT EXISTS "${DS4_DIR}/ds4_image.c")
    message("SKIP: ds4 preprocessing parity requires ${DS4_DIR}/ds4_image.c")
    return()
endif()
separate_arguments(flags UNIX_COMMAND "${C_FLAGS}")
set(library "${WORK_DIR}/ds4_image_oracle.so")
execute_process(
    COMMAND "${C_COMPILER}" ${flags} -fPIC -shared -I "${DS4_DIR}" "${DS4_DIR}/ds4_image.c" -o "${library}" -lm
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "cannot build ds4's ds4_image.c (${result})")
endif()
string(REPLACE "|" ";" images "${IMAGES}")
set(present)
set(missing)
foreach(image IN LISTS images)
    string(REGEX REPLACE "=.*$" "" path "${image}")
    if(EXISTS "${path}")
        list(APPEND present "${image}")
    else()
        list(APPEND missing "${path}")
    endif()
endforeach()
execute_process(COMMAND "${TEST_BINARY}" --ds4 "${library}" ${present} RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "preprocessing differs from ds4's (${result})")
endif()
if(missing)
    message("SKIP: fixtures absent: ${missing}")
endif()
